# Backend (worker)
BACKEND_HUB_URL=https://backend-hub-vigilanciaepi.onrender.com
PUBLIC_BACKEND_URL=
BACKEND_NODE_ID=argosepi-docker
HUB_API_KEY=
EPI_USE_TENSORRT=1

# Origens liberadas no CORS (separadas por virgula; * libera todas)
CORS_ORIGINS=https://argosepi.vercel.app,http://localhost:8088,http://127.0.0.1:8088

# IP desta maquina na rede local (no Docker o IP detectado seria o do container)
ARGOS_LOCAL_IP=

# Hub no Render
HUB_STALE_AFTER_SECONDS=45
HUB_PING_ON_HEARTBEAT=0

# Banco de dados (container "db" do docker-compose)
POSTGRES_USER=argos
POSTGRES_PASSWORD=argos
POSTGRES_DB=argosepi
# So precisa definir fora do Docker; no compose ja vem montado
# DATABASE_URL=postgresql://argos:argos@127.0.0.1:5432/argosepi

# Contas (no site) e vinculo deste servidor
# Na primeira vez o servidor abre http://localhost:8088/parear para vincular a uma conta.
# ARGOS_API_URL=https://argosepi.vercel.app/api
# Nome que aparece na pagina Servidores do site (padrao: nome do PC)
# ARGOS_SERVIDOR_NOME=PC da portaria
# Porta do painel (para ligar um segundo servidor no mesmo PC, ex.: 8089)
# ARGOS_PORTA=8088
# 0 = nao abre o navegador sozinho para o vinculo (fora do Docker)
# ARGOS_ABRIR_NAVEGADOR=1
# 0 = sem tunel do Cloudflare (so rede local)
# ARGOS_TUNEL=1
# Fuso dos graficos de desempenho
# ARGOS_FUSO=America/Bahia
# 1 = volta a aceitar o login antigo, guardado neste servidor (teste sem internet)
ARGOS_LOGIN_LOCAL=0

# Contas e seguranca
# Cadastro local (so vale com ARGOS_LOGIN_LOCAL=1).
ARGOS_CADASTRO_ABERTO=1
# Quem pode enviar modelo .pt: todos | admin | desligado.
# O PyTorch executa codigo embutido no .pt: so deixe "todos" com usuarios de confianca.
ARGOS_UPLOAD_MODELOS=todos
# Dias sem uso ate a sessao expirar e pedir login de novo
ARGOS_SESSAO_DIAS=30
# Tamanho maximo de um envio (video, modelo, zip), em MB
ARGOS_MAX_UPLOAD_MB=2048

# Reconhecimento de rosto (SCRFD + ArcFace)
# ARGOS_FACE_DIST=1.0     # distancia maxima para considerar a mesma pessoa
# ARGOS_FACE_DET=0.5      # confianca minima do detector de rosto
